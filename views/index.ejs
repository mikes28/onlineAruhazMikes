<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Articles
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<table>
    <thead>
        <tr>
            <th>Név</th>
            <th>Kategória</th>
            <th>Ár</th>
            <th>Készlet</th>
        </tr>
    </thead>

    <tbody>

       <% products.forEach(element => { %>
        <tr class="<%= element.stock < 1? 'red' : '' %>">
            <td><%= element.name %></td>
            <td><%= element.category %></td>
            <td><%= element.price %></td>
            <td class="<%= element.stock < 5 ? 'red' : '' %>">
                <%= element.stock %>

        </tr>
       <% }) %> 
    </tbody>

</table>
   <br>
    <hr>
    <br>

    <a href="/new">Hozaadas</a>
    <a href="/filter">Szures</a>
    <a href="/stats">Statisztikak</a>

</body>
</html>